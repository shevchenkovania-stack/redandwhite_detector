# Что НЕ попадает в собранный пакет (синтаксис — как у .gitignore).
# Файл нужен именно потому, что pub спрашивает git, а git знает про эти файлы
# больше, чем должен: каталоги сборки попадают в архив, если их не перечислить
# здесь явно.

# Панель-эталон: отдельное Windows-приложение, ~10 МБ тестовых картинок,
# к библиотеке отношения не имеет.
sim_app/

# Артефакты сборки и нативные кэши (иначе архив пакета весит десятки мегабайт).
build/
**/build/
.dart_tool/
**/.dart_tool/
*.dll
*.dill
*.so
*.pdb
*.cache

# Служебное и IDE.
tools/
.idea/
*.iml
